.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local large datasets and model artifacts.
projects/*/data/raw/*
!projects/*/data/raw/.gitkeep
projects/*/data/sampled/*
!projects/*/data/sampled/.gitkeep
projects/*/data/processed/*
!projects/*/data/processed/.gitkeep
projects/*/data/local/*
projects/*/models/

# Run model artifacts: model.pkl may be committed when intentionally registered.
# sample.pkl and score/data feathers are local-only caches and remain ignored;
# manifests must record their hash, size, reason, and regeneration provenance.
# Raw input data stays excluded (see data/ rules above).
projects/*/runs/**/cache/
# Office/Excel editor lock files (.~ prefix) anywhere, not just runs/
*.~*.xlsx
*.~*.xls
*.~*.docx
projects/*/runs/**/*.feather
projects/*/versions/**/*.feather
projects/*/runs/**/sample.pkl
projects/*/versions/**/sample.pkl
projects/*/runs/**/audit/agent_graph.sqlite*
projects/*/versions/**/audit/agent_graph.sqlite*
projects/*/runs/**/audit/.progress.lock
projects/*/versions/**/audit/.progress.lock

# Local generated package metadata.
*.egg-info/

# Local agent/editor configuration.
.codex/
.claude/settings.json

# Vendor D03 refinement intermediate results
projects/*/runs/feature_refine_feather_vendor_d03/

# Keep curated metadata under data/profile tracked.

# Local skill checkout is optional; runtime code is vendored under vendor/.
my-skills/

# Jupyter auto-generated checkpoints.
.ipynb_checkpoints/

# Stray root-level workspace from running rmw without --project in the repo root.
/project/
